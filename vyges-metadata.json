{
  "name": "vyges/spi-controller",
  "x-version": "1.0.0",
  "version": "1.0.0",
  "description": "Serial Peripheral Interface (SPI) master controller supporting all four SPI modes, with APB bus interface, configurable FIFO buffering, and interrupt capabilities. Enables flexible clock polarity/phase, high-speed data transfer, and easy integration into ASIC and FPGA designs",
  "license": "Apache-2.0",
  "template": "vyges-ip-template@1.0.0",
  "target": [
    "asic",
    "fpga"
  ],
  "design_type": [
    "digital"
  ],
  "maturity": "production",
  "maintainers": [
    {
      "name": "Shivaram Mysore",
      "email": "shivaram@vyges.com",
      "github": "vyges"
    }
  ],
  "provider": {
    "name": "Vyges Inc.",
    "logo": "https://vyges.com/images/logo.svg",
    "website": "https://vyges.com",
    "usage": "attribution"
  },
  "branding": {
    "provider": "Vyges",
    "logo": "https://vyges.com/images/logo.svg",
    "website": "https://vyges.com/catalog",
    "usage": "Use of the logo is permitted for attribution or compatibility references only."
  },
  "interfaces": [
    {
      "type": "bus",
      "direction": "slave",
      "protocol": "APB v2.0",
      "signals": [
        {
          "name": "pclk_i",
          "direction": "input",
          "type": "clock",
          "width": 1,
          "description": "APB clock input"
        },
        {
          "name": "presetn_i",
          "direction": "input",
          "type": "reset",
          "width": 1,
          "description": "APB reset input (active low)"
        },
        {
          "name": "psel_i",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "APB select input"
        },
        {
          "name": "penable_i",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "APB enable input"
        },
        {
          "name": "pwrite_i",
          "direction": "input",
          "type": "control",
          "width": 1,
          "description": "APB write input"
        },
        {
          "name": "paddr_i",
          "direction": "input",
          "type": "address",
          "width": 8,
          "description": "APB address input"
        },
        {
          "name": "pwdata_i",
          "direction": "input",
          "type": "data",
          "width": 32,
          "description": "APB write data input"
        },
        {
          "name": "prdata_o",
          "direction": "output",
          "type": "data",
          "width": 32,
          "description": "APB read data output"
        },
        {
          "name": "pready_o",
          "direction": "output",
          "type": "status",
          "width": 1,
          "description": "APB ready output"
        },
        {
          "name": "pslverr_o",
          "direction": "output",
          "type": "status",
          "width": 1,
          "description": "APB slave error output"
        }
      ]
    },
    {
      "type": "communication",
      "direction": "master",
      "protocol": "SPI",
      "signals": [
        {
          "name": "spi_clk_o",
          "direction": "output",
          "type": "clock",
          "width": 1,
          "description": "SPI clock output"
        },
        {
          "name": "spi_mosi_o",
          "direction": "output",
          "type": "data",
          "width": 1,
          "description": "SPI master out, slave in"
        },
        {
          "name": "spi_miso_i",
          "direction": "input",
          "type": "data",
          "width": 1,
          "description": "SPI master in, slave out"
        },
        {
          "name": "spi_csn_o",
          "direction": "output",
          "type": "control",
          "width": 1,
          "description": "SPI chip select (active low)"
        }
      ]
    },
    {
      "type": "interrupt",
      "direction": "output",
      "protocol": "Standard",
      "signals": [
        {
          "name": "spi_irq_o",
          "direction": "output",
          "type": "interrupt",
          "width": 1,
          "description": "SPI interrupt output"
        }
      ]
    }
  ],
  "parameters": [
    {
      "name": "FIFO_DEPTH",
      "type": "int",
      "default": 16,
      "description": "FIFO depth for transmit and receive",
      "required": false
    },
    {
      "name": "DATA_WIDTH",
      "type": "int",
      "default": 8,
      "description": "SPI data width",
      "required": false
    },
    {
      "name": "MAX_BAUD_DIV",
      "type": "int",
      "default": 256,
      "description": "Maximum baud rate divider",
      "required": false
    }
  ],
  "registers": {
    "CTRL": {
      "address": "0x00",
      "access": "R/W",
      "description": "Control Register"
    },
    "STAT": {
      "address": "0x04",
      "access": "R",
      "description": "Status Register"
    },
    "TXDATA": {
      "address": "0x08",
      "access": "W",
      "description": "TX Data Register"
    },
    "RXDATA": {
      "address": "0x0C",
      "access": "R",
      "description": "RX Data Register"
    },
    "BAUD": {
      "address": "0x10",
      "access": "R/W",
      "description": "Baud Rate Configuration"
    },
    "FIFO": {
      "address": "0x14",
      "access": "R/W",
      "description": "FIFO Configuration"
    },
    "INT": {
      "address": "0x18",
      "access": "R/W",
      "description": "Interrupt Configuration"
    },
    "MODE": {
      "address": "0x1C",
      "access": "R/W",
      "description": "SPI Mode Configuration"
    }
  },
  "features": [
    "APB v2.0 compliant interface",
    "Support for all 4 SPI modes (CPOL/CPHA combinations)",
    "Configurable FIFO buffering for transmit and receive",
    "Interrupt generation capabilities",
    "Configurable baud rate divider",
    "8-bit data transfers",
    "Power management with clock gating"
  ],
  "categories": {
    "primary": "communication",
    "secondary": [
      "interface",
      "controller"
    ],
    "tags": [
      "spi",
      "communication",
      "apb",
      "master",
      "fifo",
      "interrupt",
      "configurable"
    ]
  },
  "community": {
